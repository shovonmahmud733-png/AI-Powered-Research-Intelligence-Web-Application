# ==============================================================================
# Research Intelligence Platform - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Authentication & Session Security
JWT_SECRET=super-secret-jwt-key-for-research-intelligence-platform-production

# PostgreSQL Database (Optional - Defaults to embedded JSON/file-backed persistent DB)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/research_intelligence?schema=public

# Scholarly Metadata Providers
CROSSREF_API_MAILTO=researcher@university.edu
SEMANTIC_SCHOLAR_API_KEY=

# Multi-LLM Providers (Optional - The platform automatically runs in Local Academic Reasoning Engine mode if not provided)
# OpenAI API Configuration (Server-side only — never exposed to browser bundles or client code)
# Requires official OpenAI API key: sk-...
OPENAI_API_KEY=
# Configured model identifier (Defaults to 'gpt-4o-mini' if unset; supports 'gpt-4o', 'gpt-4o-mini', etc.)
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (Free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud Configuration (Free tier ultra-fast Llama-3.3-70B inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
