# ==============================================================================
# Research Intelligence Platform - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Authentication & Session Security
JWT_SECRET=super-secret-jwt-key-for-research-intelligence-platform-production

# PostgreSQL Database (Optional - Defaults to embedded JSON/file-backed persistent DB)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/research_intelligence?schema=public

# Scholarly Metadata Providers
CROSSREF_API_MAILTO=researcher@university.edu
SEMANTIC_SCHOLAR_API_KEY=

# Multi-LLM Providers (Optional - The platform automatically runs in Local Academic Reasoning Engine mode if not provided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
